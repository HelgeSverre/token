{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-editor.dev/schemas/session-annotation-chunk-candidates-v1.json",
  "title": "Token session annotation chunk candidates v1",
  "description": "Non-public map-worker candidate output. A reducer must verify and select it before producing a final sidecar.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "sourceDigest", "chunk", "candidates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startMessageId", "endMessageId"],
      "properties": {
        "startMessageId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "endMessageId": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapters", "highlights", "files"],
      "properties": {
        "summary": { "$ref": "#/$defs/claim" },
        "outcome": { "$ref": "#/$defs/claim" },
        "chapters": { "type": "array", "items": { "$ref": "#/$defs/chapter" } },
        "highlights": { "type": "array", "items": { "$ref": "#/$defs/highlight" } },
        "files": { "type": "array", "items": { "$ref": "#/$defs/file" } }
      }
    }
  },
  "$defs": {
    "messageIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "evidenceMessageIds"],
      "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 2800 }, "evidenceMessageIds": { "$ref": "#/$defs/messageIds" } }
    },
    "chapter": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "startMessageId", "evidenceMessageIds"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "startMessageId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "endMessageId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "evidenceMessageIds": { "$ref": "#/$defs/messageIds" }
      }
    },
    "highlight": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "messageId", "evidenceMessageIds"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 800 },
        "messageId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "evidenceMessageIds": { "$ref": "#/$defs/messageIds" }
      }
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "evidenceMessageIds"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "evidenceMessageIds": { "$ref": "#/$defs/messageIds" }
      }
    }
  }
}
