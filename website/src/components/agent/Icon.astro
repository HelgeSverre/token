---
const {name='chevron',class:className=''}=Astro.props;
const paths={chevron:'m9 5 7 7-7 7',close:'m6 6 12 12M6 18 18 6',arrow:'m12 5-7 7 7 7M5 12h14',external:'M14 3h7v7M21 3l-9 9M10 3H3v18h18v-7',branch:'M6 6v12M18 6v2a4 4 0 0 1-4 4h-4',check:'m5 12 4 4L19 6'};
---
<svg class:list={['agent-icon',className,{'disclosure-chevron':name==='chevron'}]} width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name]||paths.chevron}/>{name==='branch'&&<><circle cx="6" cy="4" r="2"/><circle cx="6" cy="20" r="2"/><circle cx="18" cy="4" r="2"/></>}</svg>
