---
import {markdownBlocks,messageSegments} from '../../lib/transcript-content.mjs';
import MessageBlock from './MessageBlock.astro';

const {content=''}=Astro.props;
const segments=messageSegments(content);
---
{segments.map(segment=>segment.type==='thinking'
  ? <details class="message-thinking"><summary>Reasoning</summary><div class="message-text">{markdownBlocks(segment.value).map(block=><MessageBlock block={block}/>)}</div></details>
  : <div class="message-text">{markdownBlocks(segment.value).map(block=><MessageBlock block={block}/>)}</div>
)}

<style is:global>
  .message-text p + p { margin-top: 9px; }
  .message-text code { font: .92em var(--font-mono); color: var(--fg-bright); }
  .message-text a { color: var(--syn-function); text-decoration: underline; text-underline-offset: 2px; }
  .message-text ul, .message-text ol { margin: 9px 0 0 20px; }
  .message-text li + li { margin-top: 3px; }
  .message-text blockquote { margin: 10px 0; padding-left: 12px; border-left: 2px solid var(--border-strong); color: var(--session-muted); white-space: pre-wrap; }
  .message-text hr { border: 0; border-top: 1px solid var(--border); margin: 15px 0; }
  .message-heading { margin: 15px 0 7px; color: var(--fg-bright); font-weight: 600; }
  .message-heading-1 { font-size: 1.25em; }
  .message-heading-2 { font-size: 1.14em; }
  .message-heading-3 { font-size: 1.05em; }
  .message-heading-4, .message-heading-5, .message-heading-6 { font-size: 1em; }
  .message-code { margin: 11px 0 0; max-height: 420px; overflow: auto; padding: 11px 12px; border: 1px solid var(--border); border-radius: var(--r-sm); background: var(--bg-deep); font: 11px/1.65 var(--font-mono); tab-size: 2; }
  .message-code code { color: var(--fg); }
  .message-table-scroll { max-width: 100%; margin: 11px 0 0; overflow: auto; border: 1px solid var(--border); border-radius: var(--r-sm); }
  .message-table { width: 100%; min-width: max-content; border-collapse: collapse; color: var(--fg); font: 11px/1.55 var(--font-mono); }
  .message-table th, .message-table td { padding: 8px 10px; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; }
  .message-table th:last-child, .message-table td:last-child { border-right: 0; }
  .message-table tbody tr:last-child td { border-bottom: 0; }
  .message-table th { color: var(--fg-bright); background: var(--bg-raised); font-weight: 500; }
  .message-table .align-center { text-align: center; }
  .message-table .align-right { text-align: right; }
  .message-thinking { margin: 0 0 12px; border: 1px solid var(--border); border-radius: var(--r-sm); background: var(--bg-raised); }
  .message-thinking > summary { cursor: pointer; padding: 8px 10px; color: var(--session-muted); font: 10px var(--font-mono); }
  .message-thinking > .message-text { padding: 0 10px 10px; color: var(--session-muted); font-size: 12px; }
</style>
